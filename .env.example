# Neon connection string (provisioned by the Vercel Neon integration -> `vercel env pull`)
DATABASE_URL=
# Auth.js: generate with `npx auth secret`
# GitHub fine-grained token with Issues: read/write on the repo below (server-only; used by the in-app issue form)
GITHUB_ISSUES_TOKEN=
# Optional, defaults to steven-whaley/calisthenics-tracker
GITHUB_REPO=
AUTH_SECRET=
# Google OAuth client (Google Cloud Console > APIs & Services > Credentials)
# Redirect URI: {origin}/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
