# Neon connection string (provisioned by the Vercel Neon integration -> `vercel env pull`)
DATABASE_URL=
# Auth.js: generate with `npx auth secret`
AUTH_SECRET=
# Google OAuth client (Google Cloud Console > APIs & Services > Credentials)
# Redirect URI: {origin}/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
